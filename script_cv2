import itertools
import util
from models import EEGNet, ShallowConvNet, DeepConvNet
import numpy as np
import pandas as pd
from tensorflow.keras.callbacks import ModelCheckpoint, EarlyStopping
from tensorflow.keras import utils as np_utils
from joblib import Parallel, delayed
import os

# ======== FIXED CONFIGS ========
input_format = "timeseries"
model_type = "EEGNet"
#training_files_list = ["A01T", "A02T", "A03T","A04T", "A05T", "A06T", "A07T", "A08T", "A09T"]
#testing_files_list = ["A01E", "A02E", "A03E", "A04E", "A05E", "A06E", "A07E", "A08E", "A09E"]

training_files_list = ["A01T"]
testing_files_list = ["A01E"]
tmin, tmax = 0.5, 2.5
classes = 4
dataset = "BCI 2a"
baseline = None
stop_threshold = 0  # disable early stopping unless > 0

# ======== HYPERPARAMETER GRID ========
param_grid = {
    'dropoutRate': [0.25, 0.5],
    'kernLength': [16, 32],
    'F1': [8, 16],
    'D': [2, 4],
    'F2': [16, 32],
    'bandpass': [[4, 40], [8, 30]],
    'amplitude_magnification': [1000, 2000]
}

# generate all parameter combinations
param_combos = list(itertools.product(*param_grid.values()))
param_names = list(param_grid.keys())

# Ensure log folder exists
os.makedirs("results", exist_ok=True)

# ======== FUNCTION TO RUN ONE PARAM COMBINATION ========
def run_combo(combo_idx, combo):
    params = dict(zip(param_names, combo))
    sum_accuracies = 0.0
    num_subjects = len(training_files_list)

    for i in range(num_subjects):
        training_files = [training_files_list[i]]
        test_files = [testing_files_list[i]]

        X_train_session, Y_train_session, _, _, chans, kernels, samples, names, _ = util.get_bci_2a(
            training_files, test_files,
            bandpass=params['bandpass'],
            tmin=tmin, tmax=tmax,
            mode="gdf",
            amp_mag=params['amplitude_magnification'],
            baseline=baseline
        )

        X_train_session = np.array(X_train_session)
        Y_train_session = np.array(Y_train_session)
        n_trials = X_train_session.shape[0]
        blocks_X = np.array_split(X_train_session, 4, axis=0)
        blocks_Y = np.array_split(Y_train_session, 4, axis=0)

        fold_accuracies = []

        for fold in range(4):
            test_block_idx = fold
            val_block_idx = (fold + 1) % 4
            train_block_idxs = [b for b in range(4) if b not in (test_block_idx, val_block_idx)]

            X_train = np.concatenate([blocks_X[b] for b in train_block_idxs], axis=0)
            Y_train = np.concatenate([blocks_Y[b] for b in train_block_idxs], axis=0)
            X_validate = blocks_X[val_block_idx]
            Y_validate = blocks_Y[val_block_idx]
            X_test_fold = blocks_X[test_block_idx]
            Y_test_fold = blocks_Y[test_block_idx]

            X_train = X_train.reshape(X_train.shape[0], chans, samples, kernels)
            X_validate = X_validate.reshape(X_validate.shape[0], chans, samples, kernels)
            X_test_fold = X_test_fold.reshape(X_test_fold.shape[0], chans, samples, kernels)

            Y_train_oh = np_utils.to_categorical(Y_train)
            Y_validate_oh = np_utils.to_categorical(Y_validate)
            Y_test_oh = np_utils.to_categorical(Y_test_fold)

            mean  = X_train.mean(axis=(0, 2), keepdims=True)
            std   = X_train.std(axis=(0, 2), keepdims=True)
            X_train_s    = (X_train   - mean) / (std + 1e-8)
            X_validate_s = (X_validate- mean) / (std + 1e-8)
            X_test_s     = (X_test_fold- mean) / (std + 1e-8)

            model = EEGNet(
                classes, chans, samples,
                dropoutRate=params['dropoutRate'],
                kernLength=params['kernLength'],
                F1=params['F1'], D=params['D'], F2=params['F2'],
                dropoutType='SpatialDropout2D'
            )
            model.compile(loss='categorical_crossentropy', optimizer='adam', metrics=['accuracy'])

            checkpoint_path = '/tmp/checkpoint.h5'
            checkpointer = ModelCheckpoint(filepath=checkpoint_path, verbose=0, save_best_only=True)
            callbacks = [checkpointer]
            if stop_threshold > 0:
                callbacks.append(EarlyStopping(monitor='val_loss', patience=stop_threshold, restore_best_weights=True))

            model.fit(
                X_train_s, Y_train_oh,
                batch_size=16, epochs=300,
                verbose=0, validation_data=(X_validate_s, Y_validate_oh),
                callbacks=callbacks
            )

            model.load_weights(checkpoint_path)
            preds = model.predict(X_test_s).argmax(axis=-1)
            acc_fold = np.mean(preds == Y_test_oh.argmax(axis=-1))
            fold_accuracies.append(acc_fold)

        subj_avg = np.mean(fold_accuracies)
        sum_accuracies += subj_avg

    overall_avg = sum_accuracies / num_subjects
    return {
        **params,
        "accuracy": overall_avg
    }

# ======== RUN PARALLEL SEARCH ========
results = Parallel(n_jobs=-1, verbose=10)(
    delayed(run_combo)(i+1, combo) for i, combo in enumerate(param_combos)
)

# ======== SAVE RESULTS ========
df = pd.DataFrame(results)
df.to_csv("results/hyperparam_results.csv", index=False)

# Print best combo
best_idx = df['accuracy'].idxmax()
print("\n=== BEST PARAMETERS ===")
print(df.iloc[best_idx])
